{
    "name": "opencode-antigravity-auth-updated",
    "version": "1.9.0",
    "description": "Google Antigravity IDE OAuth auth plugin for Opencode - access Gemini 3 Pro and Claude 4.6 using Google credentials",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tui": {
            "import": "./dist/tui.js"
        }
    },
    "license": "MIT",
    "author": "noefabris",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/insign/opencode-antigravity-auth-updated.git"
    },
    "homepage": "https://github.com/insign/opencode-antigravity-auth-updated#readme",
    "bugs": {
        "url": "https://github.com/insign/opencode-antigravity-auth-updated/issues"
    },
    "keywords": [
        "opencode",
        "google",
        "antigravity",
        "gemini",
        "oauth",
        "plugin",
        "auth",
        "claude"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && npx tsx scripts/fix-esm-imports.ts && tsup",
        "build:schema": "npx tsx script/build-schema.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build",
        "test:e2e:models": "npx tsx script/test-models.ts",
        "test:e2e:regression": "npx tsx script/test-regression.ts"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "devDependencies": {
        "@opentui/core": "0.5.10",
        "@opentui/solid": "0.5.10",
        "@types/node": "^26.4.1",
        "@types/proper-lockfile": "^4.1.4",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/ui": "^5.0.0",
        "esbuild-plugin-solid": "^0.6.0",
        "solid-js": "1.9.12",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0",
        "zod-to-json-schema": "^3.25.2"
    },
    "dependencies": {
        "@openauthjs/openauth": "^0.4.3",
        "@opencode-ai/plugin": "^1.18.29",
        "proper-lockfile": "^4.1.2",
        "xdg-basedir": "^5.1.0",
        "zod": "^4.5.4"
    }
}
